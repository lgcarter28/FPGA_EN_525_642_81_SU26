# Normalize source and documentation text files.
* text=auto

*.vhd  text eol=lf
*.vhdl text eol=lf
*.xdc  text eol=lf
*.tcl  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.rpt  text eol=lf
*.drawio text eol=lf

# Treat generated/coursework binaries as binary.
*.bit  binary
*.bin  binary
*.ltx  binary
*.pdf  binary
*.doc  binary
*.docx binary
*.xls  binary
*.xlsx binary
*.zip  binary
*.mp4  binary
